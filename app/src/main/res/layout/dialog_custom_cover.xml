<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="22dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp"
    app:cardElevation="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 1. 顶部标题栏 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/btn_pill_primary">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_image_cover_vector"
                        app:tint="@color/text_white" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="自定义漫画封面"
                    android:textColor="@color/text_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btn_close_cover_dialog"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close_vector"
                android:padding="8dp"
                app:tint="@color/text_muted"
                android:background="@drawable/btn_pill_surface"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <!-- 2. 当前封面预览与外部选图/恢复默认操作卡 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/bg_container"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <!-- 当前封面缩略图 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="68dp"
                    android:layout_height="94dp"
                    app:cardCornerRadius="10dp"
                    app:cardBackgroundColor="#0E1017"
                    app:strokeColor="@color/border_color"
                    app:strokeWidth="1dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_current_cover_preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <!-- 右侧信息与按钮组 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_cover_comic_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="漫画名称"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_cover_status_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="当前：默认第 1 页封面"
                        android:textColor="@color/primary_light"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_external_cover"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:layout_marginEnd="8dp"
                            android:text="从相册/文件选图"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:backgroundTint="@color/primary"
                            android:textColor="@color/text_white"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_default_cover"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="恢复默认"
                            android:textSize="11.5sp"
                            android:textAllCaps="false"
                            android:backgroundTint="#2E3348"
                            android:textColor="@color/text_secondary"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. 内页缩略图网格标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_cover_grid_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="或直接点击下方漫画画面设为封面"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_cover_total_pages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="共 0 页"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 4. 可视化漫画内页瀑布网格 (所见即所得，点击任意画面即设为封面) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_cover_pages"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:background="@drawable/search_bg"
            android:backgroundTint="#13151E"
            android:padding="6dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
