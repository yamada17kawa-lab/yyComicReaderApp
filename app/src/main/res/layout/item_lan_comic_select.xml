<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_lan_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:background="@drawable/search_bg"
    android:backgroundTint="#1D202C">

    <!-- 选择复选框 -->
    <CheckBox
        android:id="@+id/cb_lan_select"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:clickable="false"
        android:focusable="false"
        android:buttonTint="@color/primary" />

    <!-- 漫画主体信息（标题 + 元数据行） -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- 标题行：漫画标题 + 已拥有小胶囊 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_lan_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_white"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_lan_item_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/read_count_badge_bg"
                android:backgroundTint="#2610B981"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="已拥有"
                android:textColor="#6EE7B7"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 副标题行：页数 · 阅读次数 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_lan_item_pages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="共 0 页"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_lan_item_read_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="已读 0 次"
                android:textColor="#A5B4FC"
                android:textSize="11.5sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- 在线看小胶囊按钮 -->
    <TextView
        android:id="@+id/btn_lan_online_read"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:gravity="center"
        android:background="@drawable/btn_pill_primary"
        android:backgroundTint="#336366F1"
        android:paddingStart="11dp"
        android:paddingEnd="11dp"
        android:text="在线看"
        android:textColor="#E0E7FF"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</LinearLayout>
