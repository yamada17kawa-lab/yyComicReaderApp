<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- 1. Google M3 沉浸式顶栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/btn_close_lan_dialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_close_vector"
            android:padding="8dp"
            app:tint="@color/text_secondary"
            android:background="@drawable/btn_pill_surface"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btn_close_lan_dialog"
            android:layout_toStartOf="@+id/layout_lan_header_actions"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_wifi_vector"
                    app:tint="@color/primary_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="局域网互传"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_lan_conn_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="等待设备连接"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 顶栏右侧核心操作：刷新 + 设置 -->
        <LinearLayout
            android:id="@+id/layout_lan_header_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lan_refresh_remote"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="6dp"
                android:text="刷新"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_container"
                android:textColor="@color/text_white"
                app:icon="@drawable/ic_refresh_vector"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconTint="@color/text_secondary"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lan_toggle_options"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="设置"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_container"
                android:textColor="@color/text_secondary"
                app:icon="@drawable/ic_settings_vector"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconTint="@color/text_secondary"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 顶栏分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />

    <!-- 主体内容区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <!-- 2. 可折叠归类抽屉：手动IP连接 & 接收目录设置 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_lan_options_drawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="网络连接与接收设置"
                    android:textColor="@color/primary_light"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- 本机IP与接收目录行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tv_lan_self_ip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="本机地址: 正在获取..."
                            android:textColor="@color/text_white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:singleLine="true"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tv_lan_save_dir"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="接收目录: /storage/emulated/0/Download/YY漫画互传"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            android:singleLine="true"
                            android:ellipsize="middle" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lan_change_dir"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="改目录"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/bg_container"
                        android:textColor="@color/primary_light"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lan_reset_dir"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="默认"
                        android:textSize="11.5sp"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/bg_container"
                        android:textColor="@color/text_muted"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/border_color" />

                <!-- 手动IP输入与雷达扫描行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_lan_manual_ip"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/search_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:hint="手动输入设备IP (如 192.168.1.5)"
                        android:textColorHint="@color/text_subtle"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:singleLine="true"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lan_connect_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="连接"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/bg_container"
                        android:textColor="@color/text_white"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_lan_scan_peers"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="扫描"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/primary"
                        android:textColor="@color/text_white"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. 已发现设备与在线书架入口卡片 (不拥挤、独立两层结构) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="@color/bg_surface"
            app:strokeColor="@color/border_color"
            app:strokeWidth="1dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- 局域网设备横向芯片栏 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layout_lan_peers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- 设备状态行 -->
                <TextView
                    android:id="@+id/tv_lan_peer_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="2dp"
                    android:text="正在扫描同一 Wi-Fi 下的电脑与手机设备..."
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <!-- 独立通栏：一键进入电脑在线书架大按钮 (连接成功后展示，气派且不与设备芯片挤压) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lan_browse_online_shelf"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:minHeight="0dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_marginTop="6dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="进入电脑在线书架浏览 (免下载 · 零磁盘占用)"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="#1E3A8A"
                    android:textColor="#E0F2FE"
                    app:icon="@drawable/ic_laptop_vector"
                    app:iconSize="16dp"
                    app:iconTint="#93C5FD"
                    app:strokeColor="#3B82F6"
                    app:strokeWidth="1dp"
                    app:cornerRadius="9dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. 双向实时传输进度卡片 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_lan_live_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#1B1E30"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_lan_progress_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@+id/tv_lan_progress_pct"
                        android:layout_marginEnd="8dp"
                        android:text="正在传输漫画..."
                        android:textColor="#E0E7FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:singleLine="true"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_lan_progress_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0%"
                        android:textColor="@color/primary_light"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/bar_lan_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="#26FFFFFF" />

                <TextView
                    android:id="@+id/tv_lan_transfer_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="准备传输..."
                    android:textColor="#A5B4FC"
                    android:textSize="11.5sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. 传输方向双栏切换 (原生矢量图标，无任何乱码 emoji) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_lan_pull"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="从对方下载 (0)"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text_white"
                app:icon="@drawable/ic_download_vector"
                app:iconSize="15dp"
                app:iconPadding="6dp"
                app:iconTint="@color/text_white"
                app:cornerRadius="9dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_lan_push"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="发送本机漫画 (0)"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_container"
                android:textColor="@color/text_secondary"
                app:icon="@drawable/ic_upload_vector"
                app:iconSize="15dp"
                app:iconPadding="6dp"
                app:iconTint="@color/text_secondary"
                app:cornerRadius="9dp" />
        </LinearLayout>

        <!-- 6. 搜索栏与一键过滤工具行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- 搜索框 -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/search_bg"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:id="@+id/iv_lan_search_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_search_vector"
                    app:tint="@color/text_muted" />

                <EditText
                    android:id="@+id/et_lan_search_comic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/iv_lan_search_icon"
                    android:layout_toStartOf="@+id/btn_lan_clear_search"
                    android:background="@null"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:hint="搜索漫画..."
                    android:textColorHint="@color/text_subtle"
                    android:textColor="@color/text_white"
                    android:textSize="12.5sp"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/btn_lan_clear_search"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_close_vector"
                    android:padding="5dp"
                    app:tint="@color/text_muted"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />
            </RelativeLayout>

            <!-- 一键过滤未拥有按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lan_filter_missing"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="未拥有 (0)"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_container"
                android:textColor="@color/text_secondary"
                app:cornerRadius="8dp"
                android:layout_marginEnd="6dp" />

            <!-- 全选当前按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_lan_select_all"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="全选"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_container"
                android:textColor="@color/text_secondary"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- 7. 自适应漫画选择列表容器 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/search_bg"
            android:backgroundTint="#14161F"
            android:padding="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_lan_comics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="4dp" />

            <TextView
                android:id="@+id/tv_lan_empty_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="请先在上方点击连接一台局域网设备"
                android:textColor="@color/text_muted"
                android:textSize="13.5sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 8. 底部固定大按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_lan_execute_transfer"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:minHeight="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:layout_marginTop="10dp"
            android:text="下载所选漫画到本手机 (0)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:textColor="@color/text_white"
            app:icon="@drawable/ic_download_vector"
            app:iconSize="18dp"
            app:iconPadding="8dp"
            app:iconTint="@color/text_white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="12dp"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
