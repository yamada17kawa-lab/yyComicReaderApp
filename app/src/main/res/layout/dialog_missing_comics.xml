<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="14dp"
    app:cardCornerRadius="22dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp"
    app:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 标题栏 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_missing_dialog_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btn_close_missing_dialog"
                android:layout_centerVertical="true"
                android:text="丢失/未在书架显示的漫画"
                android:textColor="@color/text_white"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/btn_close_missing_dialog"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close_vector"
                android:padding="8dp"
                app:tint="@color/text_muted"
                android:background="@drawable/btn_pill_surface"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="以下漫画目录已被移动或删除，当前不在书架中展示，但仍保留着历史阅读记录："
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- 列表与空提示容器 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/search_bg"
            android:backgroundTint="#14161F"
            android:padding="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_missing_comics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tv_no_missing_tip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="没有检测到丢失或失效的漫画记录\n所有保存的漫画在本地存储中均正常存在"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 底部操作按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rescan_all"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="10dp"
                android:text="重新检测状态"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/bg_container"
                android:textColor="@color/text_white"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_all_missing"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="一键清理全部"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="@color/danger_red"
                android:textColor="@color/text_white"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
